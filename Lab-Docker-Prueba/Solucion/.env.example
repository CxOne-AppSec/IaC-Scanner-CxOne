# Archivo de ejemplo para variables de entorno
# Copia este archivo a .env y completa con tus valores reales
# IMPORTANTE: .env debe estar en .gitignore

DJANGO_SECRET_KEY=tu_secret_key_aqui
DJANGO_DEBUG=0
DB_PASSWORD=tu_password_db
API_KEY=tu_api_key
MYSQL_ROOT_PASSWORD=tu_mysql_root_password
MYSQL_DATABASE=mydb
MYSQL_USER=tu_usuario
MYSQL_PASSWORD=tu_password
REPO_USER=tu_usuario_repo
REPO_PASS=tu_password_repo
DB_USER=tu_db_user
DB_PASS=tu_db_pass
BACKUP_PASSWORD=tu_backup_password
ENCRYPTION_KEY=tu_encryption_key
S3_ACCESS_KEY=tu_s3_access_key
S3_SECRET_KEY=tu_s3_secret_key

